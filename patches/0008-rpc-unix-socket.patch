+#ifdef HAVE_SYS_UN_H
+
+void SocketCore::bindUnixSocket(const std::string& path)
+{
+  closeConnection();
+
+  if (path.size() >= sizeof(sockaddr_un::sun_path)) {
+    throw DL_ABORT_EX(
+        fmt("Unix socket path too long: %lu bytes max %lu",
+            static_cast<unsigned long>(path.size()),
+            static_cast<unsigned long>(sizeof(sockaddr_un::sun_path))));
+  }
+
+  // Remove existing socket file
+  if (a2unlink(path.c_str()) == -1 && errno != ENOENT) {
+    int errNum = errno;
+    A2_LOG_WARN(fmt("Failed to remove existing Unix socket file %s: %s",
+                    path.c_str(), util::safeStrerror(errNum).c_str()));
+  }
+
+  sock_t fd = socket(AF_UNIX, sockType_, 0);
+  if (fd == (sock_t)-1) {
+    int errNum = errno;
+    throw DL_ABORT_EX(fmt("Failed to create Unix socket: %s",
+                          util::safeStrerror(errNum).c_str()));
+  }
+  util::make_fd_cloexec(fd);
+
+  // SO_REUSEADDR is silently ignored on most platforms for AF_UNIX
+  int sockopt = 1;
+  (void)setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, (a2_sockopt_t)&sockopt,
+                   sizeof(sockopt));
+
+  applySocketBufferSize(fd);
+
+  struct sockaddr_un addr;
+  memset(&addr, 0, sizeof(addr));
+  addr.sun_family = AF_UNIX;
+  strncpy(addr.sun_path, path.c_str(), sizeof(addr.sun_path) - 1);
+  addr.sun_path[sizeof(addr.sun_path) - 1] = '\0';
+
+  if (::bind(fd, (struct sockaddr*)&addr, sizeof(addr)) == -1) {
+    int errNum = errno;
+    CLOSE(fd);
+    throw DL_ABORT_EX(fmt("Failed to bind Unix socket %s: %s", path.c_str(),
+                          util::safeStrerror(errNum).c_str()));
+  }
+
+  sockfd_ = fd;
+}
+
+#endif // HAVE_SYS_UN_H
+
